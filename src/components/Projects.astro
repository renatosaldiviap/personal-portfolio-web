---
import ProjectCard from "../components/ProjectCard.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="projects" id="projects">
  <div class="projects__content">
    <p class="projects__eyebrow">Projects</p>

    <h2>What I'm building</h2>

    <p class="projects__description">
      A selection of data-driven projects designed to be clear and actionable
      from both a technical and business perspective.
    </p>

    <div class="projects__grid">
      <ProjectCard
        title="Weather Data Analysis"
        description="Cleaning, transformation, and exploratory analysis of Australian weather data using CRISP-DM to uncover climate patterns and predictive signals."
        image={`${base}/images/projects/weather/matriz-correlacion.png`}
        technologies={[
          "Python",
          "Pandas",
          "NumPy",
          "Matplotlib",
          "Seaborn",
          "Scikit-learn",
        ]}
        url={`${base}/proyectos/weather-analysis`}
        github="https://github.com/RenatoSaldivia/australia-weather-data-analysis"
      />
      <ProjectCard
        title="Gaming & Mental Health Data Analysis"
        description="Exploratory analysis of gaming habits and their empirical correlation with anxiety, depression, and addiction indicators."
        image={`${base}/images/projects/gaming/matriz-correlacion.png`}
        technologies={[
          "Python",
          "Pandas",
          "NumPy",
          "Matplotlib",
          "Seaborn",
          "Scikit-learn",
        ]}
        url={`${base}/proyectos/gaming-analysis`}
        github="https://github.com/RenatoSaldivia/gaming-mental-health-data-analysis"
      />
      <ProjectCard
        title="Digital Health & Workplace Wellbeing Dashboard"
        description="Interactive Power BI audit covering screen exposure, stress, and burnout risk across 3,500 evaluated records."
        image={`${base}/images/projects/bi-dashboard/dashboard-preview.png`}
        technologies={[
          "Power BI",
          "DAX",
          "Data Modeling",
          "Business Intelligence",
          "People Analytics",
        ]}
        url={`${base}/proyectos/bi-dashboard`}
        github="https://github.com/RenatoSaldivia/BI_Dashboard_Salud_Bienestar"
      />
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 6rem 2rem;
    background: #0f172a;
    color: white;
  }

  .projects__content {
    width: min(1200px, calc(100% - 4rem));
    margin: 0 auto;
  }

  .projects__eyebrow {
    color: #60a5fa;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .projects h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0.5rem 0 1.5rem;
  }

  .projects__description {
    max-width: 700px;
    color: #cbd5e1;
    line-height: 1.7;
    margin: 0;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .projects {
      padding: 5rem 1.5rem;
    }

    .projects__content {
      width: 100%;
    }

    .projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>