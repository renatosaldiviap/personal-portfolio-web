---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout>
  <Header />

  <main class="case-study">
    <div class="case-study__container">
      <!-- Back Button -->
      <a href={`${base}/#projects`} class="back-link">&larr; Back to portfolio</a>

      <!-- Header / Executive Summary -->
      <header class="case-study__header">
        <p class="eyebrow">Case Study &bull; Data Analysis</p>
        <h1>Australia Weather Data Analysis</h1>
        <p class="lead">
          Data cleaning, statistical exploration, and modeling under the CRISP-DM
          methodology to identify key drivers for next-day rainfall prediction.
        </p>

        <div class="quick-facts">
          <div class="fact-card">
            <span class="fact-label">Role</span>
            <span class="fact-value">Data Analyst / ML Explorer</span>
          </div>
          <div class="fact-card">
            <span class="fact-label">Methodology</span>
            <span class="fact-value">CRISP-DM</span>
          </div>
          <div class="fact-card">
            <span class="fact-label">Stack</span>
            <span class="fact-value">Python, Pandas, Seaborn, Scikit-learn</span>
          </div>
          <div class="fact-card">
            <span class="fact-label">Deliverable</span>
            <a href="https://github.com/RenatoSaldivia/australia-weather-data-analysis" target="_blank" rel="noopener noreferrer" class="fact-link">
              GitHub Repository &rarr;
            </a>
          </div>
        </div>
      </header>

      <!-- Challenge / Business Context -->
      <section class="section-block">
        <h2>1. Challenge &amp; Context</h2>
        <p>
          Australia's climate shows high geographic and seasonal variability.
          The objective was to take a historical dataset with outliers and missing values,
          build a consistent cleaning pipeline, and determine which atmospheric variables
          carry the strongest predictive weight for next-day rain (<em>RainTomorrow</em>).
        </p>
      </section>

      <!-- Visual Gallery / CRISP-DM Evidence -->
      <section class="section-block">
        <h2>2. Visual Evidence &amp; Key Findings</h2>
        <p class="section-desc">
          Three visual milestones across the workflow: from diagnosing initial class imbalance to validating the final classification model.
        </p>

        <div class="visual-grid">
          <!-- Chart 1: Class Balance -->
          <article class="visual-card">
            <div class="visual-media">
              <img 
                src={`${base}/images/projects/weather/balance-clases.png`} 
                alt="Distribution of rainy vs. non-rainy days" 
                loading="lazy"
              />
            </div>
            <div class="visual-caption">
              <span class="step-tag">CRISP-DM Phase: Data Understanding</span>
              <h3>Class imbalance diagnosis (77.6% vs. 22.4%)</h3>
              <p>
                Dry days far outnumber rainy days. A naive model would hit ~78% accuracy by always predicting "No," making Recall and ROC-AUC essential evaluation metrics.
              </p>
            </div>
          </article>

          <!-- Chart 2: Correlation -->
          <article class="visual-card">
            <div class="visual-media">
              <img 
                src={`${base}/images/projects/weather/matriz-correlacion.png`} 
                alt="Correlation matrix across numerical variables" 
                loading="lazy"
              />
            </div>
            <div class="visual-caption">
              <span class="step-tag">CRISP-DM Phase: Data Preparation</span>
              <h3>Multicollinearity analysis &amp; feature filtering</h3>
              <p>
                The matrix exposed extreme collinearity (Pressure9am vs. Pressure3pm = 0.96) and confirmed that afternoon relative humidity (Humidity3pm) and solar radiation are primary rainfall signals.
              </p>
            </div>
          </article>

          <!-- Chart 3: Confusion Matrix -->
          <article class="visual-card">
            <div class="visual-media">
              <img 
                src={`${base}/images/projects/weather/matriz-confusion.png`} 
                alt="Normalized and raw confusion matrix of the model" 
                loading="lazy"
              />
            </div>
            <div class="visual-caption">
              <span class="step-tag">CRISP-DM Phase: Evaluation</span>
              <h3>Final performance: 78.65% effective rainfall detection</h3>
              <p>
                The final model correctly identified 78.65% of actual rain events (5,014 true positives) and 81.11% of dry days, delivering balanced, decision-ready classification.
              </p>
            </div>
          </article>
        </div>
      </section>

      <!-- Methodology & Technical Decisions -->
      <section class="section-block">
        <h2>3. Applied Workflow (CRISP-DM)</h2>
        <div class="steps-grid">
          <div class="step-card">
            <span class="step-num">01</span>
            <h4>Data Understanding</h4>
            <p>Audited data types, outlier spread, and missing-value patterns.</p>
          </div>
          <div class="step-card">
            <span class="step-num">02</span>
            <h4>Data Preparation</h4>
            <p>Applied regional median imputation and encoded wind-direction categories.</p>
          </div>
          <div class="step-card">
            <span class="step-num">03</span>
            <h4>Modeling &amp; Evaluation</h4>
            <p>Trained baseline classifiers prioritizing Recall and ROC-AUC metrics.</p>
          </div>
        </div>
      </section>

      <!-- Conclusions / Generated Value -->
      <section class="section-block callout-block">
        <h2>Key Takeaways</h2>
        <ul>
          <li><strong>Data prep over modeling:</strong> Region-aware handling of missing values substantially reduced predictive bias compared to naive global imputation.</li>
          <li><strong>High-leverage signals:</strong> Afternoon atmospheric pressure paired with temperature spread accounts for 70% of discriminative power in linear models.</li>
        </ul>
        <div class="actions">
          <a href="https://github.com/RenatoSaldivia/australia-weather-data-analysis" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            Inspect code on GitHub
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .case-study {
    padding: 5rem 1.5rem 8rem;
    background: #0f172a;
    color: #cbd5e1;
    min-height: 100vh;
  }

  .case-study__container {
    width: min(900px, 100%);
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    color: #60a5fa;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: white;
  }

  .eyebrow {
    color: #60a5fa;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    color: white;
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0 0 2rem;
  }

  .quick-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    background: #111c30;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .fact-card {
    display: flex;
    flex-direction: column;
  }

  .fact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: #64748b;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .fact-value {
    color: white;
    font-size: 0.95rem;
    font-weight: 600;
    margin-top: 0.25rem;
  }

  .fact-link {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .fact-link:hover {
    text-decoration: underline;
  }

  .section-block {
    margin-bottom: 4rem;
  }

  h2 {
    color: white;
    font-size: 1.7rem;
    margin: 0 0 1rem;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 0.5rem;
  }

  .section-desc {
    margin-bottom: 1.5rem;
  }

  .visual-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .visual-card {
    background: #111c30;
    border: 1px solid #1e293b;
    border-radius: 12px;
    overflow: hidden;
  }

.visual-media {
  width: 100%;
  background: #090e1a;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1rem;
}

.visual-media img {
  width: 100%;
  max-height: 520px;
  object-fit: contain;
  display: block;
}
  .visual-caption {
    padding: 1.5rem;
  }

  .visual-caption h3 {
    margin: 0 0 0.5rem;
    color: white;
    font-size: 1.2rem;
  }

  .visual-caption p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .step-card {
    background: #111c30;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 1.25rem;
  }

  .step-num {
    color: #60a5fa;
    font-weight: 800;
    font-size: 1.2rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  .step-card h4 {
    color: white;
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .step-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .callout-block {
    background: #111c30;
    border: 1px solid #2563eb;
    border-radius: 12px;
    padding: 2rem;
  }

  .callout-block h2 {
    border-bottom: none;
    padding-bottom: 0;
  }

  .callout-block ul {
    margin: 1rem 0 2rem;
    padding-left: 1.2rem;
    line-height: 1.7;
  }

  .callout-block li {
    margin-bottom: 0.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s;
  }

  .btn--primary {
    background: #2563eb;
    color: white;
  }

  .btn--primary:hover {
    transform: translateY(-2px);
  }

  .step-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #60a5fa;
    letter-spacing: 0.5px;
    margin-bottom: 0.35rem;
  }
</style>